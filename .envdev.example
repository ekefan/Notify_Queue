DATABASE_URL=postgresql+asyncpg://notify_queue:notify_queue@postgres:5432/notify_queue
DATABASE_POOL_SIZE=10
PYTHONPATH=src


WORKER_CONCURRENCY=5
WORKER_BATCH_SIZE=10
WORKER_POLL_INTERVAL_SECONDS=0.5
JOB_LEASE_SECONDS=30

MOCK_TRANSIENT_FAILURE_RATE=0.20
MOCK_PERMANENT_FAILURE_RATE=0.00
MOCK_MIN_LATENCY_MS=20
MOCK_MAX_LATENCY_MS=100
MOCK_LONG_PROCESSING_RATE=0.20
MOCK_LONG_PROCESSING_MAX_SECONDS=3.0

BASE_RETRY_DELAY_SECONDS=2
BACKOFF_MAX_SECONDS=300
BACKOFF_JITTER_RATIO=0.20

RATE_LIMIT_PER_HOUR=10
RECIPIENT_RATE_WINDOW_SECONDS=3600
WEBHOOK_URL=http://api:8000/webhook/receive

RABBITMQ_URL=amqp://notify_queue:notify_queue@rabbitmq/
RABBITMQ_PREFETCH=20
PUBLISHER_BATCH_SIZE=100
PUBLISHER_CONCURRENCY=25
PUBLISHER_POLL_SECONDS=0.25
PUBLISHER_METRICS_PORT=9101
WORKER_METRICS_PORT=9102
