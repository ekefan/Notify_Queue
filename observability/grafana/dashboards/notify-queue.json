{
  "annotations": {"list": []},
  "editable": true,
  "panels": [
    {
      "type": "timeseries",
      "title": "Jobs by status",
      "targets": [{"expr": "notify_jobs_by_status", "legendFormat": "{{status}}"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "Delivery results / second",
      "targets": [{"expr": "sum by (status) (rate(notify_delivery_results_total[1m]))", "legendFormat": "{{status}}"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "Processing duration p50 / p95",
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(notify_processing_seconds_bucket[5m])))", "legendFormat": "p50"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(notify_processing_seconds_bucket[5m])))", "legendFormat": "p95"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
    },
    {
      "type": "timeseries",
      "title": "Worker in-flight",
      "targets": [{"expr": "sum(notify_worker_inflight)", "legendFormat": "in-flight"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
    },
    {
      "type": "timeseries",
      "title": "Database connections",
      "targets": [
        {"expr": "sum(pg_stat_activity_count)", "legendFormat": "PostgreSQL"},
        {"expr": "sum(notify_db_pool_checked_out)", "legendFormat": "app checked out"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}
    },
    {
      "type": "timeseries",
      "title": "RabbitMQ ready / unacknowledged",
      "targets": [
        {"expr": "sum(rabbitmq_queue_messages_ready)", "legendFormat": "ready"},
        {"expr": "sum(rabbitmq_queue_messages_unacked)", "legendFormat": "unacked"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["notify-queue"],
  "templating": {"list": []},
  "time": {"from": "now-15m", "to": "now"},
  "title": "Notify Queue v2",
  "uid": "notify-queue-v2",
  "version": 1
}
