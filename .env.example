DATABASE_URL=postgresql+asyncpg://notify_queue:notify_queue@localhost:5432/notify_queue
DATABASE_POOL_SIZE=10
PYTHONPATH=src

WORKER_CONCURRENCY=5
WORKER_MAX_FETCH=10
WORKER_POLL_INTERVAL_SECONDS=0.1
JOB_LEASE_SECONDS=30

MOCK_TRANSIENT_FAILURE_RATE=0.1
MOCK_PERMANENT_FAILURE_RATE=0.2
MOCK_MIN_LATENCY_MS=40
MOCK_MAX_LATENCY_MS=60
MOCK_LONG_PROCESSING_RATE=0
MOCK_LONG_PROCESSING_MAX_SECONDS=0

BACKOFF_BASE_SECONDS=2
BACKOFF_MAX_SECONDS=300
BACKOFF_JITTER_RATIO=0.20

RECIPIENT_RATE_LIMIT=10
RECIPIENT_RATE_WINDOW_SECONDS=3600
WEBHOOK_URL=http://localhost:8000/webhook/receive
